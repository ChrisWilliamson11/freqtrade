    "db_url": "sqlite:///trades3CombinedBinHAndClucV8XH_bot.sqlite",
    "database": {
        "engine": "SQLite",
        "pool_size": 20,
        "max_overflow": 40,
        "pool_timeout": 60,
        "pool_recycle": 3600,
        "pool_pre_ping": true
    },
    "logging_config": {
        "version": 1,
        "disable_existing_loggers": false,
        "formatters": {
            "standard": {
                "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
            }
        },
        "handlers": {
            "default": {
                "level": "INFO",
                "formatter": "standard",
                "class": "logging.StreamHandler",
                "stream": "ext://sys.stdout"
            }
        },
        "loggers": {
            "uvicorn.access": {
                "handlers": [
                    "default"
                ],
                "level": "ERROR",
                "propagate": false
            },
            "freqtrade.worker": {
                "handlers": [
                    "default"
                ],
                "level": "WARNING",
                "propagate": false
            }
        }
    },
    "order_types": {
        "buy": "limit",
        "sell": "market",
        "trailing_stop_loss": "market",
        "stoploss": "limit",
        "stoploss_on_exchange": false
    },
    "bid_strategy": {
        "price_side": "ask",
        "use_order_book": true,
        "order_book_top": 1
    },
    "ask_strategy": {
        "price_side": "bid",
        "use_order_book": true,
        "order_book_top": 1
