{
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "use_exit_signal": true,
  "stake_amount": 100,
  "tradable_balance_ratio": 0.5,
  "dry_run": true,
  "strategy": "ExampleLSTMStrategy",
  "freqaimodel": "PyTorchLSTMRegressorCustom",
  "dataformat_ohlcv": "json",
  "dataformat_trades": "jsongz",
  "cancel_open_orders_on_exit": false,
  "dry_run_wallet": 2000,
  "bot_name": "freqtraderLSTM",
  "timezone": "Pacific/Auckland",
  "force_entry_enable": true,
  "initial_state": "running",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 30
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "sandbox": false,
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "rateLimit": 100,
      "requestTimeout": 30000,
      "timeout": 30000,
      "enableWs": true,
      "ws": {
        "keepAlive": 30000
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 100,
      "requestTimeout": 30000,
      "timeout": 30000,
      "enableWs": true,
      "ws": {
        "keepAlive": 30000
      }
    },
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "USDC/USDT",
      "XRP/USDT",
      "SOL/USDT",
      "FDUSD/USDT",
      "TRUMP/USDT",
      "WIF/USDT",
      "PEPE/USDT",
      "DOGE/USDT",
      "SUI/USDT",
      "BNB/USDT",
      "SPELL/USDT",
      "TAO/USDT",
      "JUP/USDT",
      "ADA/USDT",
      "TRX/USDT",
      "WLD/USDT",
      "ACH/USDT",
      "LINK/USDT",
      "ENA/USDT",
      "PENGU/USDT",
      "UNI/USDT",
      "HBAR/USDT",
      "FET/USDT",
      "BONK/USDT",
      "FLOKI/USDT",
      "MOVE/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    },
    {
      "method": "ShuffleFilter",
      "shuffle_frequency": "candle",
      "seed": 42
    }
  ],
  "freqai": {
    "enabled": true,
    "identifier": "torch-lstm-custom",
    "freqaimodel": "PyTorchLSTMRegressorCustom",
    "train_period_days": 30,
    "fit_live_predictions_candles": 300,
    "backtest_period_days": 7,
    "expiration_hours": 4,
    "live_retrain_hours": 2,
    "purge_old_models": 2,
    "save_backtest_models": true,
    "write_metrics_to_disk": true,
    "activate_tensorboard": true,
    "feature_parameters": {
      "include_timeframes": [
        "5m",
        "1h", 
        "8h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 1,
      "include_shifted_candles": 0,
      "indicator_periods_candles": [10, 20],
      "use_SVM_to_remove_outliers": false,
      "principal_component_analysis": false,
      "use_feature_normalization": true,
      "DI_threshold": 0,
      "weight_factor": 0.0
    },
    "data_split_parameters": {
      "test_size": 0.15,
      "shuffle": false
    },
    "model_training_parameters": {
      "learning_rate": 0.001,
      "trainer_kwargs": {
        "batch_size": 64,
        "n_epochs": 50
      }
    }
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8085,
    "verbosity": "warning",
    "enable_openapi": false,
    "jwt_secret_key": "somethingrandom",
    "CORS_origins": ["http://127.0.0.1:8081"],
    "username": "freqtrader",
    "password": "password"
  },
  "db_url": "sqlite:///tradesv3AIV2_bot.sqlite",
  "database": {
    "engine": "SQLite",
    "pool_size": 20,
    "max_overflow": 40,
    "pool_timeout": 60,
    "pool_recycle": 3600,
    "pool_pre_ping": true
  }
}
